{
  "manifest_version": 3,
  "name": "Grandma Guard",
  "version": "2.1.0",
  "description": "Stops high-confidence fake virus, tech-support, notification-bait, phishing, and forced-update pages.",
  "permissions": [
    "storage",
    "webNavigation",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "rule-packs-data.js",
      "rule-packs.js",
      "detection-engine.js",
      "rule-pack-sync.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "rule-packs-data.js",
        "rule-packs.js",
        "detection-engine.js",
        "detector.js",
        "trap-guard.js",
        "link-guard.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://mail.google.com/*",
        "https://outlook.live.com/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*",
        "https://mail.proton.me/*",
        "https://mail.protonmail.com/*",
        "https://mail.yahoo.com/*",
        "https://mail.yahoo.com/b/*",
        "https://mail.yahoo.com/neo/*",
        "https://*.mail.yahoo.com/*",
        "https://*.mail.yahoo.com/neo/*",
        "https://mail.aol.com/*",
        "https://outlook.aol.com/*",
        "https://www.icloud.com/mail/*",
        "https://icloud.com/mail/*",
        "https://mail.zoho.com/*",
        "https://mail.zoho.eu/*",
        "https://app.fastmail.com/*",
        "https://www.fastmail.com/*",
        "https://mail.tutanota.com/*",
        "https://app.tuta.com/*"
      ],
      "js": [
        "rule-packs-data.js",
        "rule-packs.js",
        "detection-engine.js",
        "mail-guard.js",
        "link-guard.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/logo-v2-16.png",
    "32": "icons/logo-v2-32.png",
    "48": "icons/logo-v2-48.png",
    "128": "icons/logo-v2-128.png"
  },
  "action": {
    "default_title": "Grandma Guard",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/logo-v2-16.png",
      "32": "icons/logo-v2-32.png",
      "48": "icons/logo-v2-48.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{3ae9a4ff-604c-44be-a41f-139571f7446f}",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
