{
  "manifest_version": 3,
  "name": "Grandma Guard",
  "version": "2.1.2",
  "description": "Stops high-confidence fake virus, tech-support, notification-bait, phishing, and forced-update pages.",
  "permissions": [
    "storage",
    "webNavigation",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "rule-packs-data.js",
        "rule-packs.js",
        "detection-engine.js",
        "detector.js",
        "trap-guard.js",
        "false-positive-report.js",
        "link-guard.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://mail.google.com/*",
        "https://outlook.live.com/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*",
        "https://mail.proton.me/*",
        "https://mail.protonmail.com/*",
        "https://mail.yahoo.com/*",
        "https://mail.yahoo.com/b/*",
        "https://mail.yahoo.com/neo/*",
        "https://*.mail.yahoo.com/*",
        "https://*.mail.yahoo.com/neo/*",
        "https://mail.aol.com/*",
        "https://outlook.aol.com/*",
        "https://www.icloud.com/mail/*",
        "https://icloud.com/mail/*",
        "https://mail.zoho.com/*",
        "https://mail.zoho.eu/*",
        "https://app.fastmail.com/*",
        "https://www.fastmail.com/*",
        "https://mail.tutanota.com/*",
        "https://app.tuta.com/*"
      ],
      "js": [
        "rule-packs-data.js",
        "rule-packs.js",
        "detection-engine.js",
        "false-positive-report.js",
        "mail-guard.js",
        "link-guard.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icons/logo-v2-16.png",
    "32": "icons/logo-v2-32.png",
    "48": "icons/logo-v2-48.png",
    "128": "icons/logo-v2-128.png"
  },
  "action": {
    "default_title": "Grandma Guard",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/logo-v2-16.png",
      "32": "icons/logo-v2-32.png",
      "48": "icons/logo-v2-48.png"
    }
  }
}
