{
  "manifest_version": 3,
  "name": "Grandma Guard",
  "version": "1.0.1",
  "description": "Stops high-confidence fake virus, tech-support, notification-bait, phishing, and forced-update pages.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "detection-engine.js",
        "detector.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icons/logo-v2-16.png",
    "32": "icons/logo-v2-32.png",
    "48": "icons/logo-v2-48.png",
    "128": "icons/logo-v2-128.png"
  },
  "action": {
    "default_title": "Grandma Guard",
    "default_icon": {
      "16": "icons/logo-v2-16.png",
      "32": "icons/logo-v2-32.png",
      "48": "icons/logo-v2-48.png"
    }
  }
}
